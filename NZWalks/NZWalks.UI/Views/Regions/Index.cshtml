@model IEnumerable<NZWalks.UI.Models.DTO.RegionDto>
@{
}

<h1 class="mt-3">Regions</h1>
<div class="d-flex justify-content-end">
    <a asp-controller="Regions" asp-action="Add" class="btn btn-primary mb-3">Add Region</a>
</div>

<table class="table">
    <thead>
        <tr>
            <th>Code</th>
            <th>Name</th>
            <th>Id</th>
            <th>Actions</th>

        </tr>
    </thead>
    <tbody>
        @foreach(var region in Model)
        {
            <tr>
                <td>@region.Code</td>
                <td>@region.Name</td>
                <td>@region.Id</td>
                <td>
                    <a asp-controller="Regions" asp-action="Edit" asp-route-id="@region.Id" class="btn btn-primary btn-sm">Edit</a>
                    <a asp-controller="Regions" asp-action="Delete" asp-route-id="@region.Id" class="btn btn-danger btn-sm">Delete</a>
                </td>

            </tr>
        }
)
    </tbody>
</table>